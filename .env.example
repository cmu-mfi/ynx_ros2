# --- YNX bringup launch arguments (see ynx_bringup/launch/bringup.launch.py) ---
# Copy to .env and adjust. Consumed via `docker run --env-file .env`.

# ROS log level: info | debug | error
LOG_LEVEL=error

# Robot namespace (empty = no prefix). NOTE: RViz2 does not work with a namespace.
ROBOT_NS=

# Robot model series: nex10
ROBOT_MODEL=nex10

# Robot network connection (ignored when USE_MOCK_HARDWARE=true)
ROBOT_IP=192.168.19.201
ROBOT_PORT=50300

# Mock hardware mirrors commands to states (use for testing without a real robot)
USE_MOCK_HARDWARE=true

# Force/torque sensor (netft_hardware_interface NOT included in this image -> keep false)
USE_FT_SENSOR=false
FT_SENSOR_IP=192.168.19.210

# Launch MoveIt Servo for real-time control
LAUNCH_SERVO=true

# Launch RViz2 (does NOT work when ROBOT_NS is set; needs X11 forwarding)
LAUNCH_RVIZ=false
